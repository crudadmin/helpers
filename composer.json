{
    "name": "crudadmin/helpers",
    "type": "library",
    "description": "Laravel set of helpers package for administration based on crudadmin system",
    "keywords": [
        "eshop",
        "admin",
        "laravel"
    ],
    "homepage": "https://www.marekgogol.sk",
    "license": "MIT",
    "authors": [
        {
            "name": "Marek Gogo\u013e",
            "email": "info@marekgogol.sk"
        }
    ],
    "require": {
        "php": ">=8.3.0",
        "crudadmin/crudadmin": "^6.0|dev-6.0-dev",
        "crudadmin/framework": "^6.0.1|dev-6.0-dev"
    },
    "autoload": {
        "psr-4": {
            "AdminHelpers\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AdminHelpers\\Providers\\AppServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
