{
    "name": "crudadmin/helpers",
    "type": "library",
    "description": "Laravel set of helpers package for administration based on crudadmin system",
    "keywords": [
        "eshop",
        "admin",
        "laravel"
    ],
    "homepage": "https://www.marekgogol.sk",
    "license": "MIT",
    "authors": [
        {
            "name": "Marek Gogo\u013e",
            "email": "info@marekgogol.sk"
        }
    ],
    "require": {
        "php": ">=8.3",
        "crudadmin/crudadmin": "^6.0|dev-6.0-dev",
        "crudadmin/framework": "^6.0.1|dev-6.0-dev"
    },
    "suggest": {
        "laravel/sanctum": "Required by the auth module (API tokens, logout, OAuth).",
        "propaganistas/laravel-phone": "Required for phone number identifiers of the auth module.",
        "kreait/firebase-php": "Required to send push notifications of the notifications module.",
        "phpoffice/phpspreadsheet": "Required to import xls/xlsx files by the importer module.",
        "crudadmin/socialite": "Required for social login of the auth module."
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "orchestra/testbench": "^11.2"
    },
    "autoload": {
        "psr-4": {
            "AdminHelpers\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdminHelpers\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AdminHelpers\\Providers\\AppServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../admin/dependencies/crudadmin",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../admin/dependencies/framework",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../admin/dependencies/resources",
            "options": {
                "symlink": true
            }
        }
    ]
}
